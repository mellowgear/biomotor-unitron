; constants/tasks.inc: the task slots (InitTaskList, RunTasks, StartTask, StartChildTask in src/home/system.asm) [code][U2]
MAX_TASKS	equ	0x20	; slots at wTasks (InitTaskList) [code]
TASK_SLOT_SIZE	equ	0x2E	; InitTaskList, FindFreeTaskSlot [code]
TASK_PREV	equ	0	; word: previous slot in the run list (low byte 0 = free slot, FindFreeTaskSlot) [code]
TASK_NEXT	equ	2	; word: next slot (RunTasks) [code]
TASK_PARENT	equ	4	; word: parent slot, 0 = none (StartChildTask) [code]
TASK_FLAGS	equ	7	; byte: TASK_END_BIT, TASK_END_CHILDREN_BIT [code]
TASK_FUNC	equ	0x8	; long: called by RunTasks each frame with XIZ = the slot (task_wait stores its resume point here) [code]
TASK_FUNC_HI	equ	0xA	; its high word [code]
TASK_CHILDREN	equ	0xC	; word: live children (task_wait returns while nonzero) [code]
TASK_ARG	equ	0xE	; the task's first argument word [code]
TASK_END_BIT	equ	7	; EndTask: RunTasks unlinks the slot and wakes the parent [code]
TASK_END_CHILDREN_BIT	equ	6	; EndChildTasks: the children end (RunTasks sets both bits on them) [code]
